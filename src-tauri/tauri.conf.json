{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Percolist_Panel",
  "version": "1.0.3",
  "identifier": "com.percolist.panel",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "width": 1920,
        "height": 85,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
     "nsis"
    ],
    "windows": {
      "wix": {
        "language": "pt-BR",
        "template": "main.wxs"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.percolist.com.br/updates/win32/x64/latest.json"
      ],
      "dialog": true,
      "pubkey":"dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEN0NEMEZBMTUxODE0OTkKUldTWkZCZ1YrdEI4YmVZMythNTFQVnF2NHEvZHNZVGo4QTRQa1hRdDdXZlVoQ0RFb084YTQrTDQK"
    }
  }
}
